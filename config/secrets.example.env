# ============================================================
# 密钥配置模板：复制为 secrets.env 并填入真实值
# ============================================================

# 同花顺金融数据 API（扶摇）https://fuyao.aicubes.cn
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# iFinD MCP（https://mcp.51ifind.com）在官网"个人中心-密钥"获取
IFIND_BASE_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers
IFIND_AUTH_TOKEN=

# LLM（OpenAI 兼容接口，如 DeepSeek；可留空，产品将使用预计算缓存运行）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
